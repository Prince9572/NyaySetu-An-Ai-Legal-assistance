# ============================================================
# NyaySetu AI — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# ─── AI Provider ────────────────────────────────────────────
# Supported: "gemini" | "openai"
AI_PROVIDER=gemini
# Gemini model for chat (e.g., gemini-1.5-pro, gemini-2.0-flash)
AI_MODEL=gemini-2.0-flash
AI_API_KEY=your_google_ai_api_key_here

# Embedding model used for RAG
EMBEDDING_MODEL=text-embedding-004

# ─── Database (Supabase PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres
# Or a local dev URL: postgresql+asyncpg://postgres:postgres@localhost:5432/nyaysetu

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ─── App URLs ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Comma-separated list for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Security ────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars
# JWT algorithm
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── File Storage (Supabase Storage) ─────────────────────────
STORAGE_BUCKET=nyaysetu-documents
MAX_UPLOAD_SIZE_MB=10

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ─── Environment ─────────────────────────────────────────────
# "development" | "production" | "testing"
ENVIRONMENT=development

# ─── Vite Frontend (prefix VITE_ for browser exposure) ──────
# Only expose non-sensitive public config to the browser
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_APP_NAME=NyaySetu AI
